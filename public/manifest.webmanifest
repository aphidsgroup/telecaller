{
  "name": "Buildogram Telecalling",
  "short_name": "Buildogram",
  "description": "One lead at a time telecalling for construction sales teams",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f1f5f9",
  "theme_color": "#fc6e20",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "My current lead", "short_name": "My Lead", "url": "/caller", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Admin dashboard", "short_name": "Admin", "url": "/admin", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Manager dashboard", "short_name": "Manager", "url": "/manager", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "screenshots": [],
  "launch_handler": { "client_mode": "focus-existing" }
}
